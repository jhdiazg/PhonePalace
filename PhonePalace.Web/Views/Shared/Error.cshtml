@model PhonePalace.Web.ViewModels.ErrorViewModel
@using Microsoft.AspNetCore.Diagnostics
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = Model.IsNotFound ? "Página no encontrada" : "Error";
    Layout = null; // IMPORTANTE: Desactivar Layout para evitar errores en cascada (ej. DB caída al cargar menú)
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PhonePalace</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="card shadow-lg @(Model.IsNotFound ? "border-warning" : "border-danger")">
            <div class="card-header text-white @(Model.IsNotFound ? "bg-warning text-dark" : "bg-danger")">
                <h3 class="mb-0">@(Model.IsNotFound ? "Página no encontrada" : "Error del Sistema")</h3>
            </div>
            <div class="card-body">
                <h4 class="@(Model.IsNotFound ? "text-warning-emphasis" : "text-danger")">
                    @(Model.IsNotFound
                        ? "El recurso solicitado no existe o ha sido movido."
                        : "Ocurrió un error al procesar su solicitud.")
                </h4>

                @if (Model.ShowRequestId)
                {
                    <p><strong>Código de solicitud:</strong> <code>@Model.RequestId</code></p>
                }

                @{
                    var exceptionFeature = Context.Features.Get<IExceptionHandlerPathFeature>();
                }

                @* Los detalles de la excepción solo se muestran en desarrollo; en producción se registran en el log (Serilog). *@
                @if (!Model.IsNotFound && exceptionFeature?.Error != null && Env.IsDevelopment())
                {
                    <div class="alert alert-warning mt-3">
                        <h5>Diagnóstico (Desarrollo)</h5>
                        <p><strong>Error:</strong> @exceptionFeature.Error.Message</p>
                        <p><strong>Ruta:</strong> @exceptionFeature.Path</p>
                        <hr />
                        <details>
                            <summary class="fw-bold">Ver Stack Trace Completo</summary>
                            <pre class="mt-2 bg-white p-2 border" style="white-space: pre-wrap; font-size: 0.85rem;">@exceptionFeature.Error.StackTrace</pre>
                        </details>
                    </div>
                }
                else if (!Model.IsNotFound)
                {
                    <div class="alert alert-info mt-3">
                        El detalle técnico fue registrado. Si el problema persiste, contacte al administrador
                        y proporcione el código de solicitud indicado arriba.
                    </div>
                }

                <div class="mt-4">
                    <a href="/" class="btn btn-secondary">Volver al Inicio</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
