@{
    ViewData["Title"] = "Aplicación Bloqueada";
    Layout = null;
    var pending = new List<string>();
    if (ViewBag.FacturaElectronica == true) pending.Add("Pago Facturación Electrónica");
    if (ViewBag.HostingSoporte == true) pending.Add("Hosting y Soporte");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PhonePalace</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 640px;">
        <div class="card border-warning shadow-lg">
            <div class="card-header bg-danger text-white">
                <h3 class="mb-0"><i class="fas fa-lock"></i> Aplicación Bloqueada</h3>
            </div>
            <div class="card-body">
                <h4 class="text-danger">La aplicación no está disponible temporalmente.</h4>
                <p class="mt-3">
                    Hay servicios pendientes de pago. Por favor, regularice los siguientes conceptos para continuar usando el sistema:
                </p>
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var item in pending)
                    {
                        <li class="list-group-item d-flex align-items-center">
                            <i class="fas fa-exclamation-circle text-warning me-2"></i> @item
                        </li>
                    }
                </ul>
                <div class="alert alert-light border mb-4">
                    Una vez realizado el pago, la aplicación se habilitará automáticamente.
                </div>
                <a href="/Identity/Account/Login" class="btn btn-primary">Iniciar Sesión</a>
            </div>
        </div>
    </div>
</body>
</html>